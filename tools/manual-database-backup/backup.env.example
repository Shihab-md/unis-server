# Copy only these settings into the appropriate server environment.
# Keep existing MongoDB, Redis, JWT and Google Drive settings unchanged.
# Set true only after configuring server duration/memory and saving the key.
DATABASE_BACKUP_ENABLED=false
DATABASE_BACKUP_KEY_ID=production-2026-01
DATABASE_BACKUP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_SECRET
# Optional: pin the exact existing UNIS root ID (UNIS-STAGING in staging).
DATABASE_BACKUP_DRIVE_ROOT_ID=
