# Copy to /etc/unis-backup/production.env, owned by unis-backup, mode 0600.
# Replace every placeholder. This file contains no working credentials.
UNIS_BACKUP_ENV=production
UNIS_BACKUP_ENABLED=false
UNIS_BACKUP_MONGO_URI="mongodb+srv://BACKUP_READ_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER0_HOST.mongodb.net/unisDB?authSource=admin"
UNIS_BACKUP_DRIVE_ROOT_ID=PRODUCTION_UNIS_ROOT_FOLDER_ID
UNIS_BACKUP_DRIVE_FOLDER_ID=FOLDER_ID_RETURNED_BY_INIT
UNIS_BACKUP_SECRETS_FILE=/etc/unis-backup/production-drive.json
UNIS_BACKUP_ENCRYPTION_KEY=REPLACE_WITH_CANONICAL_BASE64_OF_32_RANDOM_BYTES
UNIS_BACKUP_KEY_ID=production-v1
UNIS_BACKUP_WORK_DIR=/var/lib/unis-backup/production
UNIS_BACKUP_MONGODUMP=/usr/bin/mongodump
UNIS_BACKUP_PAUSE_HOOK=/etc/unis-backup/hooks/production-pause
UNIS_BACKUP_RESUME_HOOK=/etc/unis-backup/hooks/production-resume
