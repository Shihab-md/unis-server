[Unit]
Description=UNIS encrypted MongoDB backup (%i)
Wants=network-online.target
After=network-online.target
OnFailure=unis-mongodb-backup-failure@%i.service

[Service]
Type=oneshot
User=unis-backup
Group=unis-backup
WorkingDirectory=/opt/unis-server/tools/mongodb-backup
ExecStart=/usr/bin/node --env-file=/etc/unis-backup/%i.env /opt/unis-server/tools/mongodb-backup/backup.mjs run
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/unis-backup/%i
# Hook implementations must work with these restrictions. Do not make the worker root.
TimeoutStartSec=45min
TimeoutStopSec=130s
KillSignal=SIGTERM
# Allow the Node worker to stop mongodump and run the resume hook first.
KillMode=mixed

